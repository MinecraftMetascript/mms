{
	"name": "@mms/preview",
	"private": true,
	"version": "0.0.1",
	"description": "The worldgen previews and inspectors shared by the MMS web editor and the VS Code extension.",
	"type": "module",
	"svelte": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./worker": "./src/preview/preview.worker.ts",
		"./paths": "./src/paths.ts",
		"./tree": "./src/tree.ts",
		"./spline": "./src/spline/spline.ts",
		"./jigsaw/give": "./src/jigsaw/give.ts",
		"./jigsaw/tool": "./src/jigsaw/tool.ts",
		"./jigsaw/JigsawTool.svelte": {
			"types": "./src/jigsaw/JigsawTool.svelte",
			"svelte": "./src/jigsaw/JigsawTool.svelte",
			"default": "./src/jigsaw/JigsawTool.svelte"
		},
		"./world/tool": "./src/world/tool.ts",
		"./world/WorldTool.svelte": {
			"types": "./src/world/WorldTool.svelte",
			"svelte": "./src/world/WorldTool.svelte",
			"default": "./src/world/WorldTool.svelte"
		},
		"./theme.css": "./theme.css"
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"build:agent": "node scripts/build-agent.mjs"
	},
	"//": "Hosts install deepslate and svelte and dedupe them in their Vite config, so the components and the host share one copy; the dev copies here are for `npm run check`.",
	"peerDependencies": {
		"deepslate": "^0.27.2",
		"svelte": "^5.57.1"
	},
	"devDependencies": {
		"deepslate": "^0.27.2",
		"esbuild": "0.27.7",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3"
	}
}
