{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"deepslate": ["../node_modules/deepslate"]
		}
	},
	"include": ["*.ts", "*.svelte", "../src/messages.ts"]
}
