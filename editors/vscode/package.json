{
  "name": "mms",
  "displayName": "Minecraft Metascript",
  "description": "Language support for Minecraft Metascript (.mms): diagnostics, completion, formatting, quick fixes and worldgen previews from the MMS language server.",
  "version": "1.0.0",
  "publisher": "minecraftmetascript",
  "license": "SEE LICENSE IN README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/MinecraftMetascript/mms.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Formatters", "Linters"],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/mms.json",
    "onLanguage:mms",
    "onWebviewPanel:mms.preview"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mms",
        "aliases": ["Minecraft Metascript", "MMS"],
        "extensions": [".mms"],
        "configuration": "./language-configuration.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "mms.json",
        "url": "./schemas/mms.schema.json"
      }
    ],
    "grammars": [
      {
        "language": "mms",
        "scopeName": "source.mms",
        "path": "./syntaxes/mms.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Minecraft Metascript",
      "properties": {
        "mms.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `mms` executable, for example `/Users/you/mms/engine/mms`. `~` and `${workspaceFolder}` are expanded. Empty means `mms` on your `PATH`, then `~/go/bin/mms` (where `go install` puts it)."
        },
        "mms.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Log the messages between VS Code and the MMS language server."
        }
      }
    },
    "commands": [
      {
        "command": "mms.restartServer",
        "title": "MMS: Restart Language Server"
      },
      {
        "command": "mms.showOutput",
        "title": "MMS: Show Language Server Output"
      },
      {
        "command": "mms.showPreview",
        "title": "MMS: Open Preview to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "mms.previewDeclaration",
        "title": "MMS: Preview Declaration"
      }
    ],
    "menus": {
      "editor/title": [
        { "command": "mms.showPreview", "when": "editorLangId == mms", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "mms.showPreview", "when": "editorLangId == mms" },
        { "command": "mms.previewDeclaration", "when": "false" }
      ]
    },
    "keybindings": [
      { "command": "mms.showPreview", "key": "ctrl+k v", "mac": "cmd+k v", "when": "editorLangId == mms" }
    ],
    "configurationDefaults": {
      "[mms]": {
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --minify",
    "build:webview": "vite build --config webview/vite.config.ts",
    "check": "tsc --noEmit && svelte-check --tsconfig ./webview/tsconfig.json",
    "package": "npm run check && npm run build && vsce package --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@mms/preview": "file:../../packages/preview",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "20.19.43",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.2.1",
    "deepslate": "0.27.2",
    "esbuild": "0.27.7",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
