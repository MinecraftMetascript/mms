{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mms",
      "camelcase": "Mms",
      "title": "Minecraft Metascript",
      "scope": "source.mms",
      "file-types": ["mms"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^mms$"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "license": "UNLICENSED",
    "description": "Tree-sitter grammar for Minecraft Metascript (.mms)",
    "links": {
      "repository": "https://github.com/MinecraftMetascript/mms"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
