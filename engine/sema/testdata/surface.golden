== worldgen/material_rule mms_demo:my_strange_surface
{
  "type": "minecraft:sequence",
  "sequence": [
    {
      "type": "minecraft:condition",
      "if_true": "mms_demo:in_friendly_biome",
      "then_run": "mms_demo:honey_surface"
    },
    {
      "type": "minecraft:condition",
      "if_true": "mms_demo:in_unfriendly_biome",
      "then_run": "mms_demo:slime_surface"
    },
    {
      "type": "minecraft:block",
      "result_state": "minecraft:magma_block"
    }
  ]
}
== worldgen/material_rule mms_demo:terracotta_bands
{
  "type": "minecraft:condition",
  "if_true": {
    "type": "minecraft:stone_depth",
    "offset": 0,
    "surface_type": "floor",
    "add_surface_depth": false,
    "secondary_depth_range": 0
  },
  "then_run": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:sequence",
        "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:noise_threshold",
              "noise": "minecraft:surface",
              "min_threshold": -0.909,
              "max_threshold": -0.5454
            },
            "then_run": {
              "type": "minecraft:block",
              "result_state": "minecraft:terracotta"
            }
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:noise_threshold",
              "noise": "minecraft:surface",
              "min_threshold": -0.1818,
              "max_threshold": 0.1818
            },
            "then_run": {
              "type": "minecraft:block",
              "result_state": "minecraft:terracotta"
            }
          }
        ]
      },
      {
        "type": "minecraft:bandlands"
      }
    ]
  }
}
