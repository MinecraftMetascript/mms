      "max": 2
    }
  }
}
== recipe example:ruby_block
{
  "type": "minecraft:crafting_shaped",
  "pattern": [
    "RRR",
    "RRR",
    "RRR"
  ],
  "key": {
    "R": "minecraft:emerald"
  },
  "result": "minecraft:emerald_block"
}
== recipe example:rubies
{
  "type": "minecraft:crafting_shapeless",
  "ingredients": [
    "minecraft:emerald_block"
  ],
  "result": {
    "id": "minecraft:emerald",
    "count": 9
  }
}
== advancement example:first_gem
{
  "criteria": {
    "has_gem": {
      "trigger": "minecraft:inventory_changed",
      "conditions": {
        "items": [
          {
            "items": [
              "minecraft:diamond",
              "minecraft:emerald"
            ]
          }
        ]
      }
    }
  }
}
