== loot_table example:chests/gems
{
  "pools": [
    {
      "rolls": {
        "type": "minecraft:uniform",
        "min": 1,
        "max": 3
      },
      "entries": [
        {
          "type": "minecraft:item",
          "name": "minecraft:diamond"
        },
        {
          "type": "minecraft:item",
          "name": "minecraft:emerald"
        },
        {
          "type": "minecraft:tag",
          "items": "#minecraft:logs",
          "expand": true
        }
      ]
    },
    {
      "rolls": 1,
      "entries": [
        {
          "type": "minecraft:item",
          "name": "minecraft:gold_ingot",
          "weight": 3
        }
      ]
    }
  ]
}
== predicate example:stormy_night
{
  "type": "minecraft:all_of",
  "terms": [
    {
      "type": "minecraft:weather_check",
      "thundering": true
    },
    {
      "type": "minecraft:inverted",
      "term": {
        "type": "minecraft:any_of",
        "terms": [
          {
            "type": "minecraft:time_check",
            "clock": "minecraft:overworld",
            "value": {
              "min": 0,
              "max": 12000
            }
          },
          {
            "type": "minecraft:random_chance",
            "chance": 0.5
          }
        ]
      }
    }
  ]
}
