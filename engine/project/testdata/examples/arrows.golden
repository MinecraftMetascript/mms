=== data/arrows/function/mms_gen/load.mcfunction
scoreboard objectives add shooter_id dummy
scoreboard objectives add shot_by dummy
scoreboard objectives add mms_click.arrows dummy
scoreboard objectives add mms.arrows dummy
scoreboard players set #cf mms.arrows 0
execute unless score $shooters mms.arrows = $shooters mms.arrows run scoreboard players set $shooters mms.arrows 0
execute unless score $owner mms.arrows = $owner mms.arrows run scoreboard players set $owner mms.arrows 0
execute in minecraft:overworld run forceload add 0 0
=== data/arrows/function/mms_gen/tick.mcfunction
function arrows:mms_gen/tick/ca80342a
scoreboard players remove @a[scores={mms_click.arrows=1..}] mms_click.arrows 1
=== data/arrows/function/mms_gen/tick/ca80342a.mcfunction
execute as @e[type=arrow, tag=!arrows.seen] at @s run function arrows:spotted
execute as @e[type=arrow,tag=arrows.flying,nbt={inGround:1b}] at @s run function arrows:stuck
execute as @e[type=marker,tag=arrows.stand_in,predicate=!arrows:riding] at @s run function arrows:impact
=== data/arrows/function/mount.mcfunction
tag @s add arrows.stand_in
execute if data entity @n[type=arrow,tag=arrows.new] item.components."minecraft:custom_data"{arrow:"explosive"} run tag @s add arrows.explosive
execute if data entity @n[type=arrow,tag=arrows.new] item.components."minecraft:custom_data"{arrow:"ender"} run tag @s add arrows.ender
scoreboard players operation @s shot_by = $owner mms.arrows
ride @s mount @n[type=arrow,tag=arrows.new]
