execute as @e[type=splash_potion,tag=!arrows.thrown] run function arrows:throw_further
execute as @e[type=#minecraft:arrows,tag=!mms_shot.arrows] run function arrows:mms_gen/projectile/spotted
execute as @e[type=splash_potion,tag=!mms_shot.arrows] run function arrows:mms_gen/projectile/spotted
execute as @e[type=lingering_potion,tag=!mms_shot.arrows] run function arrows:mms_gen/projectile/spotted
execute as @e[type=marker,tag=mms_land.arrows,predicate=!arrows:mms_gen/projectile/riding] at @s run function arrows:mms_gen/projectile/land
scoreboard players remove @a[scores={mms_click.arrows=1..}] mms_click.arrows 1
