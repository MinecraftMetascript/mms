=== data/arrows/function/arm.mcfunction
tag @s add arrows.flying
scoreboard players set $owner mms.arrows 0
execute on origin unless score @s shooter_id matches 1.. run function arrows:number_shooter
execute on origin run scoreboard players operation $owner mms.arrows = @s shooter_id
tag @s add arrows.new
execute summon marker run function arrows:mount
tag @s remove arrows.new
=== data/arrows/function/ender_jump.mcfunction
scoreboard players operation $owner mms.arrows = @s shot_by
execute if score $owner mms.arrows matches 0 run return 0
execute as @e[scores={shooter_id=1..}] if score @s shooter_id = $owner mms.arrows run tag @s add arrows.jumper
execute facing entity @e[tag=arrows.jumper,limit=1] feet positioned ^ ^ ^0.5 as @e[tag=arrows.jumper,limit=1] run function arrows:land_jump
tag @e[tag=arrows.jumper] remove arrows.jumper
