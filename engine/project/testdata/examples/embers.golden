execute store result score #block mms_click.embers run attribute @s block_interaction_range get 10
execute store result score #entity mms_click.embers run attribute @s entity_interaction_range get 10
scoreboard players set #ray mms_click.embers 0
execute anchored eyes positioned ^ ^ ^ anchored feet run function embers:mms_gen/item_hook/ember_wand/press/ray
tag @s remove mms_clicker
