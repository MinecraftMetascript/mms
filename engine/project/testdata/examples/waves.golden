=== data/waves/function/mark_spawn.mcfunction
summon marker ~ ~ ~ {Tags:["waves.spawn"]}
tellraw @s {text:"Spawn point marked",color:"gray"}
=== data/waves/function/mms_gen/load.mcfunction
scoreboard objectives add wave_of dummy
scoreboard objectives add mms.waves dummy
scoreboard players set #cf mms.waves 0
execute unless data storage waves:mms arena.phase run data modify storage waves:mms arena.phase set value "idle"
execute unless data storage waves:mms arena.wave run data modify storage waves:mms arena.wave set value 0
execute unless data storage waves:mms arena.timer run data modify storage waves:mms arena.timer set value 0
=== data/waves/function/mms_gen/ret.mcfunction
scoreboard players set #cf mms.waves 0
return run scoreboard players get #rv mms.waves
=== data/waves/function/mms_gen/tick.mcfunction
function waves:mms_gen/tick/8d0c4e0d
=== data/waves/function/mms_gen/tick/8d0c4e0d.mcfunction
function waves:tick
=== data/waves/function/next_wave.mcfunction
execute store result score #next_wave.-t0 mms.waves run data get storage waves:mms arena.wave
scoreboard players add #next_wave.-t0 mms.waves 1
execute store result storage waves:mms arena.wave int 1 run scoreboard players get #next_wave.-t0 mms.waves
execute store result score #next_wave.-t1 mms.waves run data get storage waves:mms arena.wave
execute if score #next_wave.-t1 mms.waves matches 5.. run function waves:next_wave/_if0
execute if score #cf mms.waves matches 3 run return run function waves:mms_gen/ret
data modify storage waves:mms arena.phase set value "resting"
execute store result score #next_wave.-t2 mms.waves run data get storage waves:mms arena.wave
execute if score #next_wave.-t2 mms.waves matches 1 run data modify storage waves:mms arena.timer set value 100
execute store result score #next_wave.-t3 mms.waves run data get storage waves:mms arena.wave
execute if score #next_wave.-t3 mms.waves matches 2 run data modify storage waves:mms arena.timer set value 100
execute store result score #next_wave.-t4 mms.waves run data get storage waves:mms arena.wave
execute if score #next_wave.-t4 mms.waves matches 3 run data modify storage waves:mms arena.timer set value 60
execute store result score #next_wave.-t5 mms.waves run data get storage waves:mms arena.wave
execute if score #next_wave.-t5 mms.waves matches 4 run data modify storage waves:mms arena.timer set value 200
tellraw @a ["",{text:"Wave ",color:"yellow"},{nbt:"arena.wave",storage:"waves:mms",color:"yellow"},{text:" of 4 is coming",color:"yellow"}]
title @a title ["",{text:"Wave ",color:"yellow"},{nbt:"arena.wave",storage:"waves:mms",color:"yellow"},{text:" of 4 is coming",color:"yellow"}]
=== data/waves/function/next_wave/_if0.mcfunction
data modify storage waves:mms arena.phase set value "won"
tellraw @a {text:"The arena is yours!",color:"gold"}
title @a title {text:"The arena is yours!",color:"gold"}
scoreboard players set #cf mms.waves 3
return 0
=== data/waves/function/spawn.mcfunction
execute store result score #spawn.-t0 mms.waves run data get storage waves:mms arena.wave
execute if score #spawn.-t0 mms.waves matches 1 run function waves:spawn/_if0
execute store result score #spawn.-t1 mms.waves run data get storage waves:mms arena.wave
execute if score #spawn.-t1 mms.waves matches 2 run function waves:spawn/_if2
execute store result score #spawn.-t2 mms.waves run data get storage waves:mms arena.wave
execute if score #spawn.-t2 mms.waves matches 3 run function waves:spawn/_if4
execute store result score #spawn.-t3 mms.waves run data get storage waves:mms arena.wave
execute if score #spawn.-t3 mms.waves matches 4 run function waves:spawn/_if6
execute store result score #spawn.-t4 mms.waves run data get storage waves:mms arena.wave
scoreboard players operation @e[tag=waves.new] wave_of = #spawn.-t4 mms.waves
tag @e[tag=waves.new] remove waves.new
data modify storage waves:mms arena.phase set value "fighting"
