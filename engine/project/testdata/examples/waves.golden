data modify storage waves:mms arena.wave set value 0
function waves:next_wave
=== data/waves/function/tick.mcfunction
data modify storage waves:mms l."tick".-s0 set from storage waves:mms arena.phase
execute store success score #tick.-t1 mms.waves run data modify storage waves:mms l."tick".-s0 set value "resting"
scoreboard players set #tick.-f0 mms.waves 0
execute if score #tick.-t1 mms.waves matches 0 run scoreboard players set #tick.-f0 mms.waves 1
execute if score #tick.-f0 mms.waves matches 1 run function waves:tick/_if1
execute unless score #tick.-f0 mms.waves matches 1 run function waves:tick/_else2
=== data/waves/function/tick/_else2.mcfunction
data modify storage waves:mms l."tick".-s4 set from storage waves:mms arena.phase
execute store success score #tick.-t5 mms.waves run data modify storage waves:mms l."tick".-s4 set value "fighting"
execute if score #tick.-t5 mms.waves matches 0 run function waves:tick/_if3
=== data/waves/function/tick/_if1.mcfunction
execute store result score #tick.-t2 mms.waves run data get storage waves:mms arena.timer
scoreboard players remove #tick.-t2 mms.waves 1
execute store result storage waves:mms arena.timer int 1 run scoreboard players get #tick.-t2 mms.waves
execute store result score #tick.-t3 mms.waves run data get storage waves:mms arena.timer
execute if score #tick.-t3 mms.waves matches ..0 run function waves:spawn
=== data/waves/function/tick/_if3.mcfunction
execute store result score #tick.-t6 mms.waves if entity @e[tag=waves.enemy]
scoreboard players operation #tick.alive mms.waves = #tick.-t6 mms.waves
execute if score #tick.alive mms.waves matches 0 run function waves:next_wave
