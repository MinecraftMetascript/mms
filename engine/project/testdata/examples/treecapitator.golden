execute unless score $break_leaves mms.treecap = $break_leaves mms.treecap run scoreboard players set $break_leaves mms.treecap 1
execute unless score $max_leaves mms.treecap = $max_leaves mms.treecap run scoreboard players set $max_leaves mms.treecap 600
execute unless data storage treecap:mms g.kind run data modify storage treecap:mms g.kind set value ""
execute unless score $nether mms.treecap = $nether mms.treecap run scoreboard players set $nether mms.treecap 0
execute unless score $logs mms.treecap = $logs mms.treecap run scoreboard players set $logs mms.treecap 0
execute unless score $leaf_count mms.treecap = $leaf_count mms.treecap run scoreboard players set $leaf_count mms.treecap 0
execute unless score $east mms.treecap = $east mms.treecap run scoreboard players set $east mms.treecap 0
execute unless score $west mms.treecap = $west mms.treecap run scoreboard players set $west mms.treecap 0
execute unless score $south mms.treecap = $south mms.treecap run scoreboard players set $south mms.treecap 0
execute unless score $north mms.treecap = $north mms.treecap run scoreboard players set $north mms.treecap 0
