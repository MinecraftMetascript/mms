=== data/treecap/function/visit.mcfunction
summon marker ~ ~ ~ {Tags:["treecap.node"]}
scoreboard players add $logs mms.treecap 1
execute if score $logs mms.treecap > $max_logs mms.treecap run return 0
execute if block ~1 ~ ~ #minecraft:leaves[persistent=false] run scoreboard players add $leaves mms.treecap 1
execute if block ~-1 ~ ~ #minecraft:leaves[persistent=false] run scoreboard players add $leaves mms.treecap 1
execute if block ~ ~1 ~ #minecraft:leaves[persistent=false] run scoreboard players add $leaves mms.treecap 1
execute if block ~ ~-1 ~ #minecraft:leaves[persistent=false] run scoreboard players add $leaves mms.treecap 1
execute if block ~ ~ ~1 #minecraft:leaves[persistent=false] run scoreboard players add $leaves mms.treecap 1
execute if block ~ ~ ~-1 #minecraft:leaves[persistent=false] run scoreboard players add $leaves mms.treecap 1
execute if block ~1 ~ ~ #treecap:caps run scoreboard players add $leaves mms.treecap 1
execute if block ~-1 ~ ~ #treecap:caps run scoreboard players add $leaves mms.treecap 1
execute if block ~ ~1 ~ #treecap:caps run scoreboard players add $leaves mms.treecap 1
execute if block ~ ~-1 ~ #treecap:caps run scoreboard players add $leaves mms.treecap 1
execute if block ~ ~ ~1 #treecap:caps run scoreboard players add $leaves mms.treecap 1
execute if block ~ ~ ~-1 #treecap:caps run scoreboard players add $leaves mms.treecap 1
function treecap:spread
=== data/treecap/function/wear_axe.mcfunction
execute if items entity @s weapon.mainhand *[minecraft:unbreakable] run return 0
scoreboard players set $unbreaking mms.treecap 0
execute if items entity @s weapon.mainhand *[minecraft:enchantments~[{enchantments:"minecraft:unbreaking",levels:1}]] run scoreboard players set $unbreaking mms.treecap 1
execute if items entity @s weapon.mainhand *[minecraft:enchantments~[{enchantments:"minecraft:unbreaking",levels:2}]] run scoreboard players set $unbreaking mms.treecap 2
execute if items entity @s weapon.mainhand *[minecraft:enchantments~[{enchantments:"minecraft:unbreaking",levels:3}]] run scoreboard players set $unbreaking mms.treecap 3
scoreboard players operation #wear_axe._t0 mms.treecap = $unbreaking mms.treecap
scoreboard players add #wear_axe._t0 mms.treecap 1
scoreboard players operation #wear_axe.cost mms.treecap = $logs mms.treecap
scoreboard players operation #wear_axe.cost mms.treecap /= #wear_axe._t0 mms.treecap
scoreboard players operation #wear_axe._t2 mms.treecap = $unbreaking mms.treecap
scoreboard players add #wear_axe._t2 mms.treecap 1
scoreboard players operation #wear_axe.rest mms.treecap = $logs mms.treecap
scoreboard players operation #wear_axe.rest mms.treecap %= #wear_axe._t2 mms.treecap
execute if score #wear_axe.rest mms.treecap matches 1.. run function treecap:wear_axe/_if0
execute if score #wear_axe.cost mms.treecap matches 0 run return 0
summon item_display ~ ~ ~ {Tags:["treecap.tmp"]}
item replace entity @e[type=item_display,tag=treecap.tmp,limit=1] contents from entity @s weapon.mainhand
execute store result score $damage mms.treecap run data get entity @e[type=item_display,tag=treecap.tmp,limit=1] item.components."minecraft:damage"
kill @e[type=item_display,tag=treecap.tmp]
scoreboard players operation $damage mms.treecap += #wear_axe.cost mms.treecap
execute store result storage treecap:mms m.a0 int 1 run scoreboard players get $damage mms.treecap
function treecap:wear_axe/_macro2 with storage treecap:mms m
execute if items entity @s weapon.mainhand *[minecraft:damage~{durability:..0}] run function treecap:break_axe
=== data/treecap/function/wear_axe/_if0.mcfunction
execute store result storage treecap:mms m.a0 int 1 run scoreboard players get $unbreaking mms.treecap
function treecap:wear_axe/_macro1 with storage treecap:mms m
execute if score $roll mms.treecap < #wear_axe.rest mms.treecap run scoreboard players add #wear_axe.cost mms.treecap 1
=== data/treecap/function/wear_axe/_macro1.mcfunction
$execute store result score $roll mms.treecap run random value 0..$(a0)
=== data/treecap/function/wear_axe/_macro2.mcfunction
$item modify entity @s weapon.mainhand {function:"minecraft:set_components",components:{"minecraft:damage":$(a0)}}
