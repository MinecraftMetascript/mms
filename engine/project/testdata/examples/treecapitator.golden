=== data/treecap/function/farther.mcfunction
execute if score @s leaf_dist matches 1 if block ~ ~ ~ #minecraft:leaves[distance=2] run return 1
execute if score @s leaf_dist matches 2 if block ~ ~ ~ #minecraft:leaves[distance=3] run return 1
execute if score @s leaf_dist matches 3 if block ~ ~ ~ #minecraft:leaves[distance=4] run return 1
execute if score @s leaf_dist matches 4 if block ~ ~ ~ #minecraft:leaves[distance=5] run return 1
execute if score @s leaf_dist matches 5 if block ~ ~ ~ #minecraft:leaves[distance=6] run return 1
execute if score @s leaf_dist matches 6 if block ~ ~ ~ #minecraft:leaves[distance=7] run return 1
return fail
=== data/treecap/function/fell.mcfunction
scoreboard players set $logs mms.treecap 0
scoreboard players set $leaf_count mms.treecap 0
scoreboard players set $east mms.treecap 0
scoreboard players set $west mms.treecap 0
scoreboard players set $south mms.treecap 0
scoreboard players set $north mms.treecap 0
scoreboard players set $top mms.treecap 0
summon marker ~ ~ ~ {Tags:["treecap.node","treecap.origin"]}
function treecap:spread
scoreboard players set #fell.-f0 mms.treecap 0
execute if score $logs mms.treecap > $max_logs mms.treecap run scoreboard players set #fell.-f0 mms.treecap 1
execute if score #fell.-f0 mms.treecap matches 1 run title @s actionbar {text:"That is too big to fell at once",color:"gray"}
execute unless score #fell.-f0 mms.treecap matches 1 run function treecap:fell/_else1
kill @e[type=marker,tag=treecap.node]
kill @e[type=marker,tag=treecap.leaf]
