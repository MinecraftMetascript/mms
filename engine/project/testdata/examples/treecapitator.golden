function treecap:wear_axe
=== data/treecap/function/is_tree.mcfunction
scoreboard players operation #is_tree.-t1 mms.treecap = $east mms.treecap
scoreboard players operation #is_tree.-t1 mms.treecap += $west mms.treecap
scoreboard players operation #is_tree.-t1 mms.treecap += $south mms.treecap
