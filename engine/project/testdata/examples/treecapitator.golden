execute if score #cf mms.treecap matches 3 run return run function treecap:mms_gen/ret
scoreboard players set #is_tree.-t5 mms.treecap 0
execute if score #is_tree.sides mms.treecap matches 4.. run scoreboard players set #is_tree.-t5 mms.treecap 1
return run scoreboard players get #is_tree.-t5 mms.treecap
