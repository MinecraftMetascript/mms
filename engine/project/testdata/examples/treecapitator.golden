=== data/treecap/function/chopped.mcfunction
scoreboard players reset @s chop_oak
scoreboard players reset @s chop_spruce
scoreboard players reset @s chop_birch
scoreboard players reset @s chop_jungle
scoreboard players reset @s chop_acacia
scoreboard players reset @s chop_dark_oak
scoreboard players reset @s chop_mangrove
scoreboard players reset @s chop_cherry
scoreboard players reset @s chop_pale_oak
scoreboard players reset @s chop_crimson
scoreboard players reset @s chop_warped
execute if predicate treecap:sneaking run return 0
execute unless items entity @s weapon.mainhand #minecraft:axes run return 0
execute as @e[type=item,distance=..8,nbt={Age:0s}] if items entity @s contents #minecraft:logs run tag @s add treecap.drop
execute at @e[type=item, tag=treecap.drop, limit=1, sort=nearest] align xyz positioned ~0.5 ~0.5 ~0.5 run function treecap:fell
tag @e[type=item,tag=treecap.drop] remove treecap.drop
=== data/treecap/function/fell.mcfunction
scoreboard players set $logs mms.treecap 0
scoreboard players set $leaves mms.treecap 0
summon marker ~ ~ ~ {Tags:["treecap.node","treecap.origin"]}
function treecap:spread
scoreboard players set #fell._f0 mms.treecap 0
execute if score $logs mms.treecap > $max_logs mms.treecap run scoreboard players set #fell._f0 mms.treecap 1
execute if score #fell._f0 mms.treecap matches 1 run title @s actionbar {text:"That is too big to fell at once",color:"gray"}
execute unless score #fell._f0 mms.treecap matches 1 run function treecap:fell/_else1
kill @e[type=marker,tag=treecap.node]
=== data/treecap/function/fell/_else1.mcfunction
execute if score $logs mms.treecap matches 1.. if score $leaves mms.treecap >= $min_leaves mms.treecap run function treecap:fell/_if2
=== data/treecap/function/fell/_if2.mcfunction
execute as @e[type=marker,tag=treecap.node,tag=!treecap.origin] at @s run setblock ~ ~ ~ air destroy
execute as @e[type=marker,tag=treecap.node,tag=!treecap.origin] at @s as @e[type=item,distance=..1,nbt={Age:0s}] run tp @s @e[type=marker,tag=treecap.origin,limit=1]
function treecap:wear_axe
=== data/treecap/function/mms_gen/load.mcfunction
scoreboard objectives add chop_oak minecraft.mined:minecraft.oak_log
scoreboard objectives add chop_spruce minecraft.mined:minecraft.spruce_log
scoreboard objectives add chop_birch minecraft.mined:minecraft.birch_log
scoreboard objectives add chop_jungle minecraft.mined:minecraft.jungle_log
scoreboard objectives add chop_acacia minecraft.mined:minecraft.acacia_log
scoreboard objectives add chop_dark_oak minecraft.mined:minecraft.dark_oak_log
scoreboard objectives add chop_mangrove minecraft.mined:minecraft.mangrove_log
scoreboard objectives add chop_cherry minecraft.mined:minecraft.cherry_log
scoreboard objectives add chop_pale_oak minecraft.mined:minecraft.pale_oak_log
scoreboard objectives add chop_crimson minecraft.mined:minecraft.crimson_stem
scoreboard objectives add chop_warped minecraft.mined:minecraft.warped_stem
scoreboard objectives add mms.treecap dummy
scoreboard players set #cf mms.treecap 0
execute unless score $max_logs mms.treecap = $max_logs mms.treecap run scoreboard players set $max_logs mms.treecap 256
execute unless score $min_leaves mms.treecap = $min_leaves mms.treecap run scoreboard players set $min_leaves mms.treecap 3
execute unless score $logs mms.treecap = $logs mms.treecap run scoreboard players set $logs mms.treecap 0
execute unless score $leaves mms.treecap = $leaves mms.treecap run scoreboard players set $leaves mms.treecap 0
execute unless score $unbreaking mms.treecap = $unbreaking mms.treecap run scoreboard players set $unbreaking mms.treecap 0
execute unless score $roll mms.treecap = $roll mms.treecap run scoreboard players set $roll mms.treecap 0
execute unless score $damage mms.treecap = $damage mms.treecap run scoreboard players set $damage mms.treecap 0
