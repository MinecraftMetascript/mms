=== data/siege/function/standable.mcfunction
scoreboard players operation #standable.dy mms.siege = #ny cs_tmp
scoreboard players operation #standable.dy mms.siege -= #cy cs_tmp
scoreboard players set #standable._t1 mms.siege 0
execute if score #standable.dy mms.siege matches 17.. run scoreboard players set #standable._t1 mms.siege 1
execute unless score #standable._t1 mms.siege matches 1 run function siege:standable/_if0
execute if score #standable._t1 mms.siege matches 1 run return 0
execute store success score #ok cs_tmp if block ~ ~ ~ #siege:walkable if block ~ ~1 ~ #siege:walkable unless block ~ ~-1 ~ #siege:walkable unless block ~ ~ ~ #siege:hazard unless block ~ ~-1 ~ #siege:hazard in siege:scratch if block ~ ~ ~ minecraft:air
scoreboard players set #standable._t2 mms.siege 0
execute if score #ok cs_tmp matches 1 run scoreboard players set #standable._t2 mms.siege 1
return run scoreboard players get #standable._t2 mms.siege
=== data/siege/function/standable/_if0.mcfunction
execute if score #standable.dy mms.siege matches ..-17 run scoreboard players set #standable._t1 mms.siege 1
=== data/siege/function/status.mcfunction
execute store result score #enemies cs_tmp if entity @e[tag=cs_enemy]
scoreboard players operation #status.enemies mms.siege = #enemies cs_tmp
scoreboard players set #status._f0 mms.siege 0
execute if score $banner_placed mms.siege matches 1 run scoreboard players set #status._f0 mms.siege 1
execute if score #status._f0 mms.siege matches 1 run function siege:status/_if1
execute unless score #status._f0 mms.siege matches 1 run function siege:status/_else3
=== data/siege/function/status/_else3.mcfunction
execute store result storage siege:mms m.a0 int 1 run scoreboard players get #status.enemies mms.siege
function siege:status/_macro4 with storage siege:mms m
