scoreboard players operation #siege_tick.g mms.siege = $ticks mms.siege
scoreboard players operation #siege_tick.g mms.siege %= #c4 mms.siege
scoreboard players set #siege_tick._f0 mms.siege 0
execute if score #siege_tick.g mms.siege matches 0 run scoreboard players set #siege_tick._f0 mms.siege 1
execute if score #siege_tick._f0 mms.siege matches 1 as @e[tag=cs_enemy,scores={cs_group=0}] at @s run function siege:enemy_update
execute unless score #siege_tick._f0 mms.siege matches 1 run function siege:siege_tick/_else1
execute if score $path_phase mms.siege matches 1.. run function siege:path_tick
scoreboard players operation #siege_tick._t1 mms.siege = $ticks mms.siege
scoreboard players operation #siege_tick._t1 mms.siege %= #c20 mms.siege
execute if score #siege_tick._t1 mms.siege matches 0 run function siege:banner_second
