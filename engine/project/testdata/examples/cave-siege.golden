=== data/siege/function/visit_column.mcfunction
scoreboard players set #v cs_tmp 0
scoreboard players operation #ny cs_tmp = #py cs_tmp
execute if function siege:standable run return run function siege:mark
scoreboard players set #v cs_tmp 1
scoreboard players operation #ny cs_tmp = #py cs_tmp
scoreboard players add #ny cs_tmp 1
execute positioned ~ ~1 ~ if function siege:standable run return run function siege:mark
scoreboard players set #v cs_tmp 2
scoreboard players operation #ny cs_tmp = #py cs_tmp
scoreboard players remove #ny cs_tmp 1
execute positioned ~ ~-1 ~ if function siege:standable run return run function siege:mark
