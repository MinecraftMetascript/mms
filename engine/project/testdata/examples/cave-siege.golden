=== data/siege/function/steer.mcfunction
scoreboard players set #tgt cs_tmp 0
execute on target run scoreboard players set #tgt cs_tmp 1
execute on target if entity @s[tag=cs_carrot] run scoreboard players set #tgt cs_tmp 2
execute on target if entity @s[tag=cs_parked] run scoreboard players set #tgt cs_tmp 3
scoreboard players operation #steer.tgt mms.siege = #tgt cs_tmp
execute if score #steer.tgt mms.siege matches 0 run function siege:steer/_if0
execute if score #steer.tgt mms.siege matches 2.. run function siege:steer/_if1
scoreboard players set #steer._t1 mms.siege 0
execute if score #steer.tgt mms.siege matches 3 run scoreboard players set #steer._t1 mms.siege 1
scoreboard players operation #bow_check.parked mms.siege = #steer._t1 mms.siege
function siege:bow_check
