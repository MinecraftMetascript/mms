scoreboard players operation #visit.dz mms.siege -= #cz cs_tmp
scoreboard players set #visit._t2 mms.siege 0
execute if score #visit.dx mms.siege matches 33.. run scoreboard players set #visit._t2 mms.siege 1
execute unless score #visit._t2 mms.siege matches 1 run function siege:visit/_if0
scoreboard players set #visit._t3 mms.siege 0
execute if score #visit._t2 mms.siege matches 1 run scoreboard players set #visit._t3 mms.siege 1
execute unless score #visit._t3 mms.siege matches 1 run function siege:visit/_if1
scoreboard players set #visit._t4 mms.siege 0
execute if score #visit._t3 mms.siege matches 1 run scoreboard players set #visit._t4 mms.siege 1
execute unless score #visit._t4 mms.siege matches 1 run function siege:visit/_if2
execute if score #visit._t4 mms.siege matches 1 run return 0
scoreboard players operation #nx cs_tmp = #visit.x mms.siege
scoreboard players operation #nz cs_tmp = #visit.z mms.siege
execute store result storage siege:mms m.a0 int 1 run scoreboard players get #visit.x mms.siege
execute store result storage siege:mms m.a1 int 1 run scoreboard players get #visit.y mms.siege
execute store result storage siege:mms m.a2 int 1 run scoreboard players get #visit.z mms.siege
function siege:visit/_macro3 with storage siege:mms m
