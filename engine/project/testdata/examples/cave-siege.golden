=== data/siege/function/mms_gen/load.mcfunction
scoreboard objectives add cs_tmp dummy
scoreboard objectives add cs_group dummy
scoreboard objectives add cs_age dummy
scoreboard objectives add cs_prev dummy
scoreboard objectives add cs_stuck dummy
scoreboard objectives add cs_break dummy
scoreboard objectives add mms.siege dummy
scoreboard players set #cf mms.siege 0
scoreboard players set #c3 mms.siege 3
scoreboard players set #c4 mms.siege 4
scoreboard players set #c5 mms.siege 5
scoreboard players set #c7 mms.siege 7
scoreboard players set #c20 mms.siege 20
scoreboard players set #c25 mms.siege 25
scoreboard players set #c200 mms.siege 200
execute unless score $banner_placed mms.siege = $banner_placed mms.siege run scoreboard players set $banner_placed mms.siege 0
execute unless score $banner_hp mms.siege = $banner_hp mms.siege run scoreboard players set $banner_hp mms.siege 100
execute unless score $banner_max mms.siege = $banner_max mms.siege run scoreboard players set $banner_max mms.siege 100
execute unless score $ticks mms.siege = $ticks mms.siege run scoreboard players set $ticks mms.siege 0
execute unless score $path_phase mms.siege = $path_phase mms.siege run scoreboard players set $path_phase mms.siege 0
execute unless score $path_dirty mms.siege = $path_dirty mms.siege run scoreboard players set $path_dirty mms.siege 0
