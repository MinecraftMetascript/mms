execute if score #banner_second.lost mms.siege matches 1.. run function siege:banner_second/_if2
execute if score $banner_hp mms.siege matches ..0 run function siege:banner_second/_if3
execute if score #cf mms.siege matches 3 run return run function siege:mms_gen/ret
execute store result storage siege:mms m.a0 int 1 run scoreboard players get $banner_hp mms.siege
function siege:banner_second/_macro4 with storage siege:mms m
