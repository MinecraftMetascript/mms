execute unless entity @s[type=minecraft:creeper] on target if entity @s[distance=..3] at @s run function siege:carrot_near
=== data/siege/function/stuck_check.mcfunction
execute store result score #ex cs_tmp run data get entity @s Pos[0]
execute store result score #ey cs_tmp run data get entity @s Pos[1]
execute store result score #ez cs_tmp run data get entity @s Pos[2]
scoreboard players operation #stuck_check.dx mms.siege = #ex cs_tmp
scoreboard players operation #stuck_check.dx mms.siege -= #cx cs_tmp
scoreboard players operation #stuck_check.dy mms.siege = #ey cs_tmp
scoreboard players operation #stuck_check.dy mms.siege -= #cy cs_tmp
scoreboard players operation #stuck_check.dz mms.siege = #ez cs_tmp
scoreboard players operation #stuck_check.dz mms.siege -= #cz cs_tmp
execute if score #stuck_check.dx mms.siege matches ..-1 run function siege:stuck_check/_if0
execute if score #stuck_check.dy mms.siege matches ..-1 run function siege:stuck_check/_if1
execute if score #stuck_check.dz mms.siege matches ..-1 run function siege:stuck_check/_if2
scoreboard players operation #stuck_check._t7 mms.siege = #stuck_check.dx mms.siege
scoreboard players operation #stuck_check._t7 mms.siege += #stuck_check.dy mms.siege
scoreboard players operation #stuck_check._t7 mms.siege += #stuck_check.dz mms.siege
scoreboard players operation #stuck_check.d mms.siege = #stuck_check._t7 mms.siege
execute store result score #near cs_tmp if entity @a[distance=..8,gamemode=!spectator,gamemode=!creative]
scoreboard players operation #stuck_check._t8 mms.siege = @s cs_prev
scoreboard players remove #stuck_check._t8 mms.siege 2
execute if score #stuck_check.d mms.siege > #stuck_check._t8 mms.siege if score @s cs_stuck matches ..0 if score #near cs_tmp matches 0 run scoreboard players set @s cs_stuck 50
scoreboard players operation @s cs_prev = #stuck_check.d mms.siege
