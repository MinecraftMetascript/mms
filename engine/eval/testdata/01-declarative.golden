=== 01-declarative.mms (changed: false)
# at 01-declarative.mms:2:1
ItemTag gems = [diamond, emerald, amethyst_shard]
# at 01-declarative.mms:4:1
LootTable chests/gems {
  pools = [Pool(1..3, #gems)]
}
# at 01-declarative.mms:8:1
Recipe gem_block = Shaped(["GG", "GG"], { G = #gems }, emerald_block)
# at 01-declarative.mms:10:1
Advancement found {
  criteria = { got = InventoryChanged(items = [{ items = #gems }]) }
  rewards = {
    function = run {
      /say found it
    }
  }
}
