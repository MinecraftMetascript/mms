# at items.mms:7:12, def 07-custom-item.mms:48:7 < Blueprint CustomItem (at items.mms:7:12, def 07-custom-item.mms:2:1)
RightClickHook mms_gen/item_hook/bell/right_click {
  item = demo:bell
  run = run {
    /playsound block.bell.use player @s
  }
}
