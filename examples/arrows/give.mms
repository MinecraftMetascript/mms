/**
 * Data packs cannot add items to the creative menu, so this gives one of
 * everything: /function arrows:give
 */
Function give {
  /give @s bow
  /give @s ${thunder_bow}
  /give @s ${explosive_arrow} 16
  /give @s ${ender_arrow} 16
  /give @s ${levitation_arrow} 16
  /give @s ${blast_potion} 8
  /give @s ${cow_wand}
}
