  "item.minecraft.tipped_arrow.effect.arrows.ender" = "Ender Arrow"
  "item.minecraft.tipped_arrow.effect.arrows.levitation" = "Arrow of Levitation"
  "enchantment.arrows.thunder" = "Thunder"
}
